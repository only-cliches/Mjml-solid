{
  "name": "mjml-solid",
  "version": "1.4.0",
  "license": "MIT",
  "description": "SolidJS component library to generate the HTML emails on the fly",
  "keywords": [
    "mjml",
    "solidjs",
    "solid-js",
    "email",
    "email-templates",
    "html-email",
    "responsive-email",
    "transactional-email",
    "mjml-to-html",
    "render",
    "compiler",
    "ssr",
    "vite",
    "plugin",
    "jsx"
  ],
  "author": "Scott Lott <me@scottlott.com>",
  "homepage": "https://github.com/only-cliches/Mjml-solid",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/only-cliches/Mjml-solid.git"
  },
  "bugs": {
    "url": "https://github.com/only-cliches/Mjml-solid/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "directories": {
    "test": "test"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig-esm.json --emitDeclarationOnly && vite build --config vite.build.config.ts && node scripts/finalize-dist.mjs",
    "prepack": "npm run build",
    "test": "npm run test:types && vitest run",
    "test:types": "npm run build && tsc -p tsconfig.json --noEmit && tsc -p tsconfig-types.json --noEmit && tsc -p tsconfig-types-nodenext.json --noEmit",
    "test-dist-skip-build": "vitest run --config vitest.dist.config.ts",
    "test-dist": "npm run build && npm run test-dist-skip-build"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "mjml": "^5.4.1",
    "solid-js": "^1.9.17",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.5",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "mjml": "^5.4.1",
    "solid-js": "^1.9.17"
  },
  "module": "dist/index.js",
  "dependencies": {
    "@types/mjml": "^5.4.1",
    "csstype": "^3.2.3"
  }
}
